---
const services = [
  {
    title: 'Apartment Complex Security',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    body: 'Professional guards keep your community safe, handling resident concerns with courtesy and professionalism. Available 24/7 or on scheduled shifts.',
    href: '/security-services/apartment-complex/',
  },
  {
    title: 'Public Auctions',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    body: 'Crowd control and asset protection for public auctions of all sizes. Our guards manage traffic flow and secure merchandise and equipment.',
    href: '/security-services/auctions/',
  },
  {
    title: 'Construction Sites',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>`,
    body: 'Secure your tools, equipment, and materials from theft. Our guards are present during and after hours to protect your valuable assets.',
    href: '/security-services/construction-sites/',
  },
  {
    title: 'Festivals & Major Events',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>`,
    body: 'Large crowd management for festivals, concerts, and major public gatherings. We handle safety at public events with experienced personnel.',
    href: '/security-services/festivals-major-events/',
  },
  {
    title: 'Sporting Events',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 21h8m-4-4v4m-5-8a5 5 0 0010 0V4H7v5zm10-3h3a2 2 0 012 2v1a4 4 0 01-4 4h-1m-10-7H4a2 2 0 00-2 2v1a4 4 0 004 4h1"/></svg>`,
    body: 'Keep athletes and spectators safe at sporting events, conventions, and tournaments. Professional security at professional and amateur venues.',
    href: '/security-services/sporting-events/',
  },
  {
    title: 'Concerts',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 10v2a7 7 0 01-14 0v-2M12 19v4m-4 0h8"/></svg>`,
    body: 'Venue security and crowd control for concerts and live performances. We manage safety for both indoor and outdoor concert venues.',
    href: '/security-services/concert-security/',
  },
  {
    title: 'High School Events',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>`,
    body: 'From sporting events to proms and graduations, we keep your school events safe. Our staff works seamlessly with school administrators.',
    href: '/security-services/high-school-events/',
  },
  {
    title: 'Restaurant & Hospitality',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 2v20M6 2v7a3 3 0 006 0V2M9 9v13M14 2h2a2 2 0 012 2v6a2 2 0 01-2 2h-2V2z"/></svg>`,
    body: 'Overnight and maintenance-period security for restaurants and hospitality venues. We protect your establishment during vulnerable hours.',
    href: '/security-services/restaurant-maintenance/',
  },
  {
    title: 'Private Investigations',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
    body: 'Our licensed private investigators provide discreet, professional investigative services for individuals and businesses throughout Pennsylvania.',
    href: '/security-services/private-investigation/',
  },
];
---

<section id="services" class="bg-background py-24 md:py-32" data-ps="src/components/security-services/ServicesGrid.astro:1a0iwy">
  <div class="max-w-7xl mx-auto px-6" data-ps="src/components/security-services/ServicesGrid.astro:d0zu6t">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-ps="src/components/security-services/ServicesGrid.astro:d0zu6s">
      {
        services.map((service, __psIdx) => (
          <a
            href={service.href}
            class="bg-surface border border-gray-100 p-8 rounded-none flex flex-col h-full justify-between hover:-translate-y-1 transition-all duration-300 group shadow-sm"
           data-ps={`src/components/security-services/ServicesGrid.astro:nq2y12-${__psIdx}`}>
            <div data-ps={`src/components/security-services/ServicesGrid.astro:d0zu6r-${__psIdx}`}>
              <div class="w-12 h-12 bg-primary/10 flex items-center justify-center text-primary mb-6" set:html={service.icon} data-ps={`src/components/security-services/ServicesGrid.astro:d0zu6q-${__psIdx}`}>
              </div>
              <h3 class="text-[18px] font-bold text-foreground mb-4 uppercase tracking-wide" data-ps={`src/components/security-services/ServicesGrid.astro:zgx6mn-${__psIdx}`}>
                {service.title}
              </h3>
              <p class="text-[14px] text-muted-foreground leading-relaxed mb-6" data-ps={`src/components/security-services/ServicesGrid.astro:nhtq0a-${__psIdx}`}>{service.body}</p>
            </div>
            <span class="text-primary text-[12px] font-bold tracking-wider uppercase group-hover:text-primary-hover flex items-center gap-1" data-ps={`src/components/security-services/ServicesGrid.astro:ubtjdb-${__psIdx}`}>
              Learn More <i class="ri-arrow-right-line" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
