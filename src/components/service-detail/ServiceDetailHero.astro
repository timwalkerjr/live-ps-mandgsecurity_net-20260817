---
export interface Props {
  title: string;
  subtitle: string;
  bgImage?: string;
}

const { 
  title, 
  subtitle, 
  bgImage = "https://pagesmith-cdn.com/f57c14f2/images/cinematic-wide-shot-of-professional-corporate-and-event-secu-b6f6806f-1024.webp" 
} = Astro.props;
---

<section id="service-hero" class="relative bg-dark-background overflow-hidden" data-ps="src/components/service-detail/ServiceDetailHero.astro:lhc1td">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/service-detail/ServiceDetailHero.astro:luozza">
    <img 
      src={bgImage} 
      alt={title} 
      class="w-full h-full object-cover opacity-35" 
      loading="eager"
      fetchpriority="high" data-ps="src/components/service-detail/ServiceDetailHero.astro:jb63cl" />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-dark-background/65 to-dark-background/75" data-ps="src/components/service-detail/ServiceDetailHero.astro:luozz9"></div>
  </div>

  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
   data-ps="src/components/service-detail/ServiceDetailHero.astro:luozza">
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-[140px] pb-[60px] md:pt-[160px] md:pb-[80px]" data-ps="src/components/service-detail/ServiceDetailHero.astro:luozz9">
    <div class="flex items-center gap-2 mb-6" data-ps="src/components/service-detail/ServiceDetailHero.astro:luozz8">
      <span class="w-1.5 h-4 bg-primary block" data-ps="src/components/service-detail/ServiceDetailHero.astro:2ihq1g"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary" data-ps="src/components/service-detail/ServiceDetailHero.astro:2ihq1f">Security Services</span>
    </div>

    <h1 class="text-[38px] leading-[42px] md:text-[60px] md:leading-[60px] font-bold uppercase tracking-tight text-dark-foreground max-w-[900px]" data-ps="src/components/service-detail/ServiceDetailHero.astro:cq76e9">
      {title}
    </h1>

    <p class="text-[16px] leading-[26px] text-dark-muted-foreground mt-6 max-w-[720px]" data-ps="src/components/service-detail/ServiceDetailHero.astro:4w3jo8">
      {subtitle}
    </p>

    <nav
      aria-label="Breadcrumb"
      class="flex flex-wrap items-center gap-2 mt-10 pt-8 border-t border-dark-border/40 text-[11px] font-bold uppercase tracking-wider text-dark-muted-foreground"
     data-ps="src/components/service-detail/ServiceDetailHero.astro:aa9sj8">
      <a href="/" class="hover:text-primary transition-colors" data-ps="src/components/service-detail/ServiceDetailHero.astro:gorqpe">Home</a>
      <span class="text-dark-muted-foreground/50" data-ps="src/components/service-detail/ServiceDetailHero.astro:27kgmz">/</span>
      <a href="/security-services/" class="hover:text-primary transition-colors" data-ps="src/components/service-detail/ServiceDetailHero.astro:gorqpf">Security Services</a>
      <span class="text-dark-muted-foreground/50" data-ps="src/components/service-detail/ServiceDetailHero.astro:27kgn0">/</span>
      <span class="text-primary" data-ps="src/components/service-detail/ServiceDetailHero.astro:27kgn1">{title}</span>
    </nav>
  </div>
</section>
