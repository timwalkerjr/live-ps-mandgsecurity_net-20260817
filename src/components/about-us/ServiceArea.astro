---
---

<section class="bg-dark-background py-24 md:py-32 relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 25% 50%, oklch(0.75 0.16 85 / 0.08), rgba(0, 0, 0, 0) 55%);"
  ></div>
  <div class="max-w-7xl mx-auto px-6 relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <div class="mb-6">
          <span class="w-6 h-0.5 bg-primary mb-4 block"></span>
          <span class="text-primary text-[10px] uppercase font-bold tracking-widest">Service Area</span>
        </div>
        <h2 class="text-[36px] leading-[44px] font-bold uppercase tracking-tight text-dark-foreground mb-6">
          Proudly Serving Berks County &amp; Surrounding Areas
        </h2>
        <p class="text-[16px] leading-[24px] text-dark-muted-foreground">
          We provide security services throughout Berks County, Pennsylvania and surrounding areas. Whether you need event security in Reading, construction site protection in Wyomissing, or corporate security anywhere in the county, M&amp;G Security is ready to serve.
        </p>
      </div>

      <div class="bg-dark-background/50 border border-dark-border p-8 rounded-none">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
          <li class="flex items-center gap-3 text-dark-foreground font-bold uppercase text-[12px] tracking-wider">
            <i class="ri-map-pin-line text-primary"></i>
            Reading, PA
          </li>
          <li class="flex items-center gap-3 text-dark-foreground font-bold uppercase text-[12px] tracking-wider">
            <i class="ri-map-pin-line text-primary"></i>
            Wyomissing, PA
          </li>
          <li class="flex items-center gap-3 text-dark-foreground font-bold uppercase text-[12px] tracking-wider">
            <i class="ri-map-pin-line text-primary"></i>
            Berks County
          </li>
          <li class="flex items-center gap-3 text-dark-foreground font-bold uppercase text-[12px] tracking-wider">
            <i class="ri-map-pin-line text-primary"></i>
            Surrounding Areas
          </li>
        </ul>
        <div class="border-t border-dark-border mt-8 pt-6">
          <p class="text-dark-muted-foreground text-[12px] uppercase tracking-wider font-bold mb-2">Notable Venues</p>
          <p class="text-dark-foreground text-[14px] leading-relaxed">
            Santander Arena · Reading Royals · Local Schools · Construction Sites · Corporate Properties
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
