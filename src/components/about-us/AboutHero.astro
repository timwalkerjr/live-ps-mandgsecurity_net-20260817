---
const bgImage = "https://pagesmith-cdn.com/f57c14f2/images/distinguished-law-enforcement-veteran-security-officers-stan-f6857ade-1024.webp";
---

<section class="bg-dark-background text-dark-muted-foreground pt-[140px] pb-[60px] md:pt-[160px] md:pb-[80px] relative overflow-hidden" data-ps="src/components/about-us/AboutHero.astro:j9e52m">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/about-us/AboutHero.astro:byauez">
    <img 
      src={bgImage} 
      alt="KRE & M&G Security Leadership" 
      class="w-full h-full object-cover opacity-25" 
      loading="eager"
      fetchpriority="high" data-ps="src/components/about-us/AboutHero.astro:hwy48b" />
    <div class="absolute inset-0 bg-dark-background/80" data-ps="src/components/about-us/AboutHero.astro:byauf0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-dark-background/30 via-transparent to-dark-background" data-ps="src/components/about-us/AboutHero.astro:byauf1"></div>
  </div>

  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
   data-ps="src/components/about-us/AboutHero.astro:byauf2"></div>
  <div class="max-w-5xl mx-auto px-6 flex flex-col items-center text-center relative z-10" data-ps="src/components/about-us/AboutHero.astro:byauf3">
    <div class="flex items-center gap-2 mb-6" data-ps="src/components/about-us/AboutHero.astro:byauf4">
      <span class="w-1.5 h-4 bg-primary" data-ps="src/components/about-us/AboutHero.astro:j0sn9j"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary" data-ps="src/components/about-us/AboutHero.astro:j0sn9k">About Us</span>
    </div>
    <h1 class="text-[44px] sm:text-[54px] md:text-[60px] leading-[1.08] font-bold uppercase tracking-tight text-dark-foreground mb-8" data-ps="src/components/about-us/AboutHero.astro:xnfyio">
      Bonded, Insured &amp; Built on <span class="text-primary" data-ps="src/components/about-us/AboutHero.astro:j0sn9l">Integrity</span>
    </h1>
    <p class="text-[16px] md:text-[18px] leading-[28px] max-w-[760px] text-dark-muted-foreground" data-ps="src/components/about-us/AboutHero.astro:xpt3bb">
      KRE Security LLC. was founded in August of 1990 and recently acquired M&amp;G Security, expanding our capabilities and footprint across Berks County and Pennsylvania. Every assignment and investigation is conducted ethically, morally, legally, and with the highest degree of integrity.
    </p>
  </div>
</section>
