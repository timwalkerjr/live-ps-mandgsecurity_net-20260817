---
import Container from '@/components/Container.astro';
---

<section id="hiring" class="py-24 bg-dark-background relative overflow-hidden border-t-4 border-primary" data-ps="src/components/home/Hiring.astro:section">
  <!-- Decorative Grid & Glow -->
  <div class="absolute inset-0 z-0 opacity-10" style="background-image: radial-gradient(var(--color-dark-border) 1px, transparent 1px); background-size: 30px 30px;" data-ps="src/components/home/Hiring.astro:grid"></div>
  <div class="absolute inset-0 z-0 bg-[radial-gradient(at_80%_50%,var(--color-primary)_0,transparent_50%)] opacity-20" data-ps="src/components/home/Hiring.astro:overlay"></div>

  <Container class="relative z-10 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-12 max-w-7xl mx-auto">
    <div class="flex-grow max-w-3xl" data-ps="src/components/home/Hiring.astro:content">
      <h2 class="text-[32px] leading-[1.2] font-bold uppercase tracking-tight text-dark-foreground mb-4" data-ps="src/components/home/Hiring.astro:h2">
        WE ARE HIRING
      </h2>
      <p class="text-[16px] leading-[24px] text-dark-muted-foreground" data-ps="src/components/home/Hiring.astro:p">
        M&G Security is always looking for qualified security guards to join our team. If you are a current or retired law enforcement officer, we want to hear from you.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 shrink-0" data-ps="src/components/home/Hiring.astro:ctas">
      <a href="/employment-opportunities/" class="group flex items-center gap-3 bg-primary text-foreground font-bold uppercase tracking-widest text-[13px] px-10 py-5 rounded-none hover:bg-primary-hover transition-all shadow-[0_0_30px_rgba(255,184,0,0.15)] hover:shadow-[0_0_40px_rgba(255,184,0,0.3)]" data-ps="src/components/home/Hiring.astro:jx3k0g">
        APPLY NOW
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/contact-us/" class="border border-dark-foreground/30 text-dark-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-white/5 transition-colors" data-ps="src/components/home/Hiring.astro:jx3k0h">
        CONTACT US
      </a>
    </div>
  </Container>
</section>
