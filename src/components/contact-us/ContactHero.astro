---
const bgImage = "https://pagesmith-cdn.com/f57c14f2/images/modern-24-7-security-dispatch-and-operations-communication-c-ed715b22-1024.webp";
---

<section class="bg-dark-background text-dark-muted-foreground pt-[140px] pb-[60px] md:pt-[160px] md:pb-[80px] relative overflow-hidden" data-ps="src/components/contact-us/ContactHero.astro:7ldx82">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/contact-us/ContactHero.astro:k6zb39">
    <img 
      src={bgImage} 
      alt="Security Quote & Contact" 
      class="w-full h-full object-cover opacity-25" 
      loading="eager"
      fetchpriority="high" data-ps="src/components/contact-us/ContactHero.astro:kyvs8l" />
    <div class="absolute inset-0 bg-dark-background/80" data-ps="src/components/contact-us/ContactHero.astro:k6zb38"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-dark-background/30 via-transparent to-dark-background" data-ps="src/components/contact-us/ContactHero.astro:k6zb37"></div>
  </div>

  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
   data-ps="src/components/contact-us/ContactHero.astro:k6zb36"></div>
  <div class="max-w-4xl mx-auto px-6 flex flex-col items-center text-center relative z-10" data-ps="src/components/contact-us/ContactHero.astro:k6zb35">
    <div class="flex items-center gap-2 mb-6" data-ps="src/components/contact-us/ContactHero.astro:k6zb34">
      <span class="w-1.5 h-4 bg-primary" data-ps="src/components/contact-us/ContactHero.astro:pbi40p"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary" data-ps="src/components/contact-us/ContactHero.astro:pbi40o">Contact</span>
    </div>
    <h1 class="text-[60px] leading-[60px] font-bold uppercase tracking-tight text-dark-foreground mb-8" data-ps="src/components/contact-us/ContactHero.astro:last0g">
      Get Your <span class="text-primary" data-ps="src/components/contact-us/ContactHero.astro:pbi40n">Security Quote</span>
    </h1>
    <p class="text-[16px] leading-[26px] max-w-[720px] text-dark-muted-foreground" data-ps="src/components/contact-us/ContactHero.astro:uj3sex">
      Contact M&amp;G Security today for a free, no-obligation quote. Our team will assess your security needs and provide a customized solution.
    </p>
  </div>
</section>
