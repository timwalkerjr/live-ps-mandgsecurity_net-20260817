---
---

<section class="bg-dark-background py-24 md:py-32 relative overflow-hidden" data-ps="src/components/contact-us/ContactForm.astro:hdf5c3">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(at 25% 50%, oklch(0.75 0.16 85 / 0.08), rgba(0, 0, 0, 0) 55%);"
   data-ps="src/components/contact-us/ContactForm.astro:8n7ex9"></div>
  <div class="max-w-3xl mx-auto px-6 relative" data-ps="src/components/contact-us/ContactForm.astro:8n7exa">
    <div class="text-center mb-12" data-ps="src/components/contact-us/ContactForm.astro:8n7exb">
      <div class="mb-6 inline-flex flex-col items-center" data-ps="src/components/contact-us/ContactForm.astro:8n7exc">
        <span class="w-6 h-0.5 bg-primary mb-4 mx-auto" data-ps="src/components/contact-us/ContactForm.astro:frlzo1"></span>
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest" data-ps="src/components/contact-us/ContactForm.astro:frlzo0">Send a Message</span>
      </div>
      <h2 class="text-[36px] leading-[44px] font-bold uppercase tracking-tight text-dark-foreground mb-4" data-ps="src/components/contact-us/ContactForm.astro:dcis4y">
        Send Us a Message
      </h2>
      <p class="text-[16px] leading-[24px] text-dark-muted-foreground" data-ps="src/components/contact-us/ContactForm.astro:6jdnvt">
        Fill out the form below and we will get back to you within 24 hours.
      </p>
    </div>

    <form
      id="contact-form"
      action="https://formspree.io/f/xzepgydj"
      method="POST"
      class="bg-dark-background/50 border border-dark-border p-8 md:p-12 rounded-none grid grid-cols-1 md:grid-cols-2 gap-6"
    >
      <input type="hidden" name="_next" value="/thank-you/" />
      <input type="hidden" name="_subject" value="New Website Inquiry — M&G Security" />

      <div class="flex flex-col gap-2" data-ps="src/components/contact-us/ContactForm.astro:8n7exd">
        <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider" data-ps="src/components/contact-us/ContactForm.astro:ayyb0i">First Name</label>
        <input
          type="text"
          name="firstName"
          required
          class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
        />
      </div>
      <div class="flex flex-col gap-2" data-ps="src/components/contact-us/ContactForm.astro:8n7exe">
        <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider" data-ps="src/components/contact-us/ContactForm.astro:ayyb14">Last Name</label>
        <input
          type="text"
          name="lastName"
          required
          class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
        />
      </div>
      <div class="flex flex-col gap-2" data-ps="src/components/contact-us/ContactForm.astro:8n7exf">
        <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider" data-ps="src/components/contact-us/ContactForm.astro:ayyb15">Email</label>
        <input
          type="email"
          name="email"
          required
          class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
        />
      </div>
      <div class="flex flex-col gap-2" data-ps="src/components/contact-us/ContactForm.astro:8n7exg">
        <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider" data-ps="src/components/contact-us/ContactForm.astro:ayyb16">Phone</label>
        <input
          type="tel"
          name="phone"
          class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary"
        />
      </div>
      <div class="flex flex-col gap-2 md:col-span-2" data-ps="src/components/contact-us/ContactForm.astro:8n7exh">
        <label class="text-dark-muted-foreground text-[12px] uppercase font-bold tracking-wider" data-ps="src/components/contact-us/ContactForm.astro:ayyb17">Message</label>
        <textarea
          name="message"
          rows="5"
          required
          class="bg-dark-background border border-dark-border text-dark-foreground px-4 py-3 rounded-none focus:outline-none focus:border-primary resize-none"
        ></textarea>
      </div>
      <div class="md:col-span-2" data-ps="src/components/contact-us/ContactForm.astro:8n7exi">
        <button
          type="submit"
          id="contact-submit-btn"
          class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-primary-hover w-full md:w-auto flex items-center justify-center gap-2 transition-colors disabled:opacity-75 disabled:cursor-not-allowed"
         data-ps="src/components/contact-us/ContactForm.astro:97g67i">
          <i class="ri-send-plane-line"></i>
          <span data-ps="src/components/contact-us/ContactForm.astro:ppo7nn">Send Message</span>
        </button>
        <p id="contact-form-error" class="text-red-400 text-xs mt-3 hidden" data-ps="src/components/contact-us/ContactForm.astro:waf1ns">There was an issue sending your message. Please try again or call us directly at (610) 562-0971.</p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const errorMsg = document.getElementById('contact-form-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<span class="inline-block animate-spin mr-2">⟳</span> Sending...`;
      }
      if (errorMsg) errorMsg.classList.add('hidden');

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (response.ok) {
          window.location.href = '/thank-you/';
        } else {
          // Fallback to traditional submit if Formspree returns non-200
          form.submit();
        }
      } catch (err) {
        // In case of network errors or fetch blockage, submit normally
        form.submit();
      }
    });
  }
</script>
  </div>
</section>
