---
---

<section class="bg-background py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <div class="mb-6 inline-flex flex-col items-center">
        <span class="w-6 h-0.5 bg-primary mb-4 mx-auto"></span>
        <span class="text-primary text-[10px] uppercase font-bold tracking-widest">How to Apply</span>
      </div>
      <h2 class="text-[48px] leading-[48px] font-bold uppercase tracking-tight text-foreground mb-4">
        3-Step Application Process
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <div class="bg-surface border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 relative">
        <div class="text-primary text-[36px] font-bold mb-4">01</div>
        <h3 class="text-[18px] font-bold text-foreground mb-4 uppercase tracking-wide">Download Application</h3>
        <p class="text-[14px] text-muted-foreground leading-relaxed">
          Download our official M&amp;G Security employment application form. Print and complete all required fields.
        </p>
      </div>

      <div class="bg-surface border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 relative">
        <div class="text-primary text-[36px] font-bold mb-4">02</div>
        <h3 class="text-[18px] font-bold text-foreground mb-4 uppercase tracking-wide">Complete &amp; Attach Documents</h3>
        <p class="text-[14px] text-muted-foreground leading-relaxed">
          Fill out the application thoroughly and attach any relevant certifications, resumes, or law enforcement credentials.
        </p>
      </div>

      <div class="bg-surface border border-gray-100 p-8 rounded-none hover:-translate-y-1 transition-all duration-300 relative">
        <div class="text-primary text-[36px] font-bold mb-4">03</div>
        <h3 class="text-[18px] font-bold text-foreground mb-4 uppercase tracking-wide">Submit Application</h3>
        <p class="text-[14px] text-muted-foreground leading-relaxed">
          Return your completed application to our office or submit it via the form below. Our hiring manager will contact you within 5 business days.
        </p>
      </div>
    </div>
  </div>
</section>
