---
const bgImage = "https://pagesmith-cdn.com/f57c14f2/images/distinguished-law-enforcement-veteran-security-officers-stan-f6857ade-1024.webp";
---

<section class="bg-dark-background text-dark-muted-foreground pt-[140px] pb-[60px] md:pt-[160px] md:pb-[80px] relative overflow-hidden" data-ps="src/components/employment-opportunities/EmploymentHero.astro:ucoflr">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/employment-opportunities/EmploymentHero.astro:a1557s">
    <img 
      src={bgImage} 
      alt="Security Guard Careers" 
      class="w-full h-full object-cover opacity-25" 
      loading="eager"
      fetchpriority="high" data-ps="src/components/employment-opportunities/EmploymentHero.astro:ju3tfi" />
    <div class="absolute inset-0 bg-dark-background/80" data-ps="src/components/employment-opportunities/EmploymentHero.astro:a1557t"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-dark-background/30 via-transparent to-dark-background" data-ps="src/components/employment-opportunities/EmploymentHero.astro:a1557u"></div>
  </div>

  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
   data-ps="src/components/employment-opportunities/EmploymentHero.astro:a1557v"></div>
  <div class="max-w-4xl mx-auto px-6 flex flex-col items-center text-center relative z-10" data-ps="src/components/employment-opportunities/EmploymentHero.astro:a1557w">
    <div class="flex items-center gap-2 mb-6" data-ps="src/components/employment-opportunities/EmploymentHero.astro:a1557x">
      <span class="w-1.5 h-4 bg-primary" data-ps="src/components/employment-opportunities/EmploymentHero.astro:vjfr7q"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary" data-ps="src/components/employment-opportunities/EmploymentHero.astro:vjfr7p">Careers</span>
    </div>
    <h1 class="text-[60px] leading-[60px] font-bold uppercase tracking-tight text-dark-foreground mb-8" data-ps="src/components/employment-opportunities/EmploymentHero.astro:rt5sz1">
      Join the <span class="text-primary" data-ps="src/components/employment-opportunities/EmploymentHero.astro:vjfr7o">M&amp;G Team</span>
    </h1>
    <p class="text-[16px] leading-[26px] max-w-[720px] text-dark-muted-foreground" data-ps="src/components/employment-opportunities/EmploymentHero.astro:7xdkyi">
      M&amp;G Security is always looking for qualified security guards to join our team. If you are a current or retired law enforcement officer, we want to hear from you.
    </p>
  </div>
</section>
