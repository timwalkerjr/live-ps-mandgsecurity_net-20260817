---
const bgImage = "https://pagesmith-cdn.com/f57c14f2/images/cinematic-wide-shot-of-professional-corporate-and-event-secu-b6f6806f-1024.webp";
---

<section class="bg-dark-background text-dark-muted-foreground pt-[140px] pb-[60px] md:pt-[160px] md:pb-[80px] relative overflow-hidden" data-ps="src/components/photo-gallery/GalleryHero.astro:2hmvpp">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr1z">
    <img 
      src={bgImage} 
      alt="M&G Security in Action" 
      class="w-full h-full object-cover opacity-25" 
      loading="eager"
      fetchpriority="high" data-ps="src/components/photo-gallery/GalleryHero.astro:rmt1ex" />
    <div class="absolute inset-0 bg-dark-background/80" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr20"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-dark-background/30 via-transparent to-dark-background" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr21"></div>
  </div>

  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);"
   data-ps="src/components/photo-gallery/GalleryHero.astro:8crr22"></div>
  <div class="max-w-4xl mx-auto px-6 flex flex-col items-center text-center relative z-10" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr23">
    <div class="flex items-center gap-2 mb-6" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr24">
      <span class="w-1.5 h-4 bg-primary" data-ps="src/components/photo-gallery/GalleryHero.astro:eoib46"></span>
      <span class="text-[12px] uppercase font-bold tracking-widest text-primary" data-ps="src/components/photo-gallery/GalleryHero.astro:eoib47">Gallery</span>
    </div>
    <h1 class="text-[60px] leading-[60px] font-bold uppercase tracking-tight text-dark-foreground mb-8" data-ps="src/components/photo-gallery/GalleryHero.astro:oom2fq">
      M&amp;G Security <span class="text-primary" data-ps="src/components/photo-gallery/GalleryHero.astro:eoib48">in Action</span>
    </h1>
    <p class="text-[16px] leading-[26px] max-w-[720px] text-dark-muted-foreground" data-ps="src/components/photo-gallery/GalleryHero.astro:4xqsmn">
      Photos from events, construction sites, and venues across Berks County where M&amp;G Security has provided professional protection.
    </p>
  </div>
</section>

<section class="bg-dark-background border-t border-dark-border py-8" data-ps="src/components/photo-gallery/GalleryHero.astro:2hmvpq">
  <div class="max-w-7xl mx-auto px-6" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr25">
    <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4" data-ps="src/components/photo-gallery/GalleryHero.astro:8crr26">
      <a
        href="#oktoberfest"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
       data-ps="src/components/photo-gallery/GalleryHero.astro:c1opbn">
        Oktoberfest
      </a>
      <a
        href="#arena-sporting"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
       data-ps="src/components/photo-gallery/GalleryHero.astro:c1opbo">
        Arena &amp; Sporting
      </a>
      <a
        href="#school-community"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
       data-ps="src/components/photo-gallery/GalleryHero.astro:c1opca">
        School &amp; Community
      </a>
      <a
        href="#our-team"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
       data-ps="src/components/photo-gallery/GalleryHero.astro:c1opcb">
        Our Team
      </a>
      <a
        href="#operations-patrol"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
       data-ps="src/components/photo-gallery/GalleryHero.astro:c1opcc">
        Operations &amp; Patrol
      </a>
      <a
        href="#festivals-events"
        class="text-dark-foreground hover:text-primary text-[12px] uppercase font-bold tracking-wider transition-colors border border-dark-border px-4 py-2 rounded-none"
       data-ps="src/components/photo-gallery/GalleryHero.astro:c1opcd">
        Festivals &amp; Events
      </a>
    </div>
  </div>
</section>
