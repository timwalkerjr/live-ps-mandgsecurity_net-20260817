---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  title?: string;
}

const { headings = [], title = 'Table of Contents' } = Astro.props;

// Filter to h2 and h3 only (h1 is the page title, h4+ too granular)
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <details class="group bg-surface border border-gray-100 rounded-none shadow-sm open:shadow-md transition-shadow" data-ps="src/components/TableOfContents.astro:sidebar-toc-card">
    <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:bg-gray-50/70 transition-colors" data-ps="src/components/TableOfContents.astro:toc-header">
      <div class="flex items-center gap-2.5 min-w-0" data-ps="src/components/TableOfContents.astro:toc-header-left">
        <i class="ri-list-check-2 text-primary text-base shrink-0" aria-hidden="true"></i>
        <h4 class="text-foreground text-[14px] font-bold uppercase font-heading tracking-wide truncate" data-ps="src/components/TableOfContents.astro:toc-title">
          {title}
        </h4>
        <span class="text-[11px] font-semibold text-muted-foreground bg-background border border-border px-1.5 py-0.5" data-ps="src/components/TableOfContents.astro:toc-count">
          {tocHeadings.length}
        </span>
      </div>
      <div class="flex items-center gap-1.5 text-muted-foreground text-xs font-semibold group-open:text-primary shrink-0" data-ps="src/components/TableOfContents.astro:toc-toggle-indicator">
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200 group-open:rotate-180" aria-hidden="true"></i>
      </div>
    </summary>

    <div class="px-5 pb-5 pt-1 border-t border-border/60" data-ps="src/components/TableOfContents.astro:toc-body">
      <nav aria-label="Table of contents" data-ps="src/components/TableOfContents.astro:toc-nav">
        <ul class="flex flex-col gap-1 pt-3" data-ps="src/components/TableOfContents.astro:toc-list">
          {tocHeadings.map((heading, idx) => (
            <li
              class={heading.depth === 3 ? 'pl-3.5 border-l border-border/80 ml-1.5' : ''}
              data-ps={`src/components/TableOfContents.astro:toc-item-${idx}`}
            >
              <a
                href={`#${heading.slug}`}
                class={`group/link flex items-start gap-1.5 py-1 px-1.5 -mx-1.5 rounded-none text-[12.5px] leading-[18px] transition-colors duration-150 hover:bg-primary/5 hover:text-primary ${
                  heading.depth === 2
                    ? 'text-foreground font-semibold'
                    : 'text-muted-foreground font-medium'
                }`}
                data-ps={`src/components/TableOfContents.astro:toc-link-${idx}`}
              >
                <span
                  class="text-primary/70 group-hover/link:text-primary font-mono text-[11px] font-bold select-none shrink-0 mt-px"
                  aria-hidden="true"
                  data-ps={`src/components/TableOfContents.astro:38qg06-${idx}`}
                >
                  #
                </span>
                <span class="group-hover/link:underline underline-offset-2 break-words" data-ps={`src/components/TableOfContents.astro:38qg05-${idx}`}>
                  {heading.text}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </details>
)}
