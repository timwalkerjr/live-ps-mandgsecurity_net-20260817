---
import '@/styles/global.css';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEOHead.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { SITE } from '@/config/site';

const { frontmatter, mdxFilePath = '', headings = [] } = Astro.props as {
  frontmatter: any;
  mdxFilePath?: string;
  headings?: any[];
};
const htmlLang = frontmatter.lang ?? Astro.currentLocale ?? SITE.lang;

// Use ogImage if set, otherwise fall back to featured image
const socialImage = frontmatter.ogImage || frontmatter.image;
const heroBgImage = frontmatter.heroImage || frontmatter.image || frontmatter.ogImage || 'https://pagesmith-cdn.com/f57c14f2/images/modern-24-7-security-dispatch-and-operations-communication-c-ed715b22-1024.webp';

// Build JSON-LD structured data based on schemaType or default to Article
const schemaType = frontmatter.schemaType || 'Article';
const schemaData = frontmatter.schemaData || {};

// Base JSON-LD structure
const jsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: frontmatter.title,
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.pubDate?.toISOString?.(),
  author: {
    '@type': 'Person',
    name: frontmatter.author || SITE.name,
  },
  url: new URL(Astro.url.pathname, SITE.url).toString(),
};

// Add modified date if available
if (frontmatter.updatedDate) {
  jsonLd.dateModified = frontmatter.updatedDate.toISOString();
}

// Add image to schema if available
if (socialImage) {
  jsonLd.image = socialImage.startsWith('http')
    ? socialImage
    : new URL(socialImage, SITE.url).toString();
}

const finalJsonLd: any[] = [jsonLd];

if (frontmatter.faqs && frontmatter.faqs.length > 0) {
  finalJsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: frontmatter.faqs.map((q: any) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: q.answer,
      },
    })),
  });
}

// Merge custom schemaData for specific schema types
if (schemaType === 'Recipe' && schemaData) {
  // Recipe-specific fields
  if (schemaData.prepTime) jsonLd.prepTime = `PT${schemaData.prepTime.replace(/\s+/g, '').toUpperCase()}`;
  if (schemaData.cookTime) jsonLd.cookTime = `PT${schemaData.cookTime.replace(/\s+/g, '').toUpperCase()}`;
  if (schemaData.totalTime) jsonLd.totalTime = `PT${schemaData.totalTime.replace(/\s+/g, '').toUpperCase()}`;
  if (schemaData.servings) jsonLd.recipeYield = schemaData.servings;
  if (schemaData.cuisine) jsonLd.recipeCuisine = schemaData.cuisine;
  if (schemaData.category) jsonLd.recipeCategory = schemaData.category;
  if (schemaData.ingredients) jsonLd.recipeIngredient = schemaData.ingredients;
  if (schemaData.instructions) {
    jsonLd.recipeInstructions = Array.isArray(schemaData.instructions)
      ? schemaData.instructions.map((step: string, i: number) => ({
          '@type': 'HowToStep',
          position: i + 1,
          text: step,
        }))
      : schemaData.instructions;
  }
} else if (schemaType === 'HowTo' && schemaData) {
  // HowTo-specific fields
  if (schemaData.totalTime) jsonLd.totalTime = `PT${schemaData.totalTime.replace(/\s+/g, '').toUpperCase()}`;
  if (schemaData.steps) {
    jsonLd.step = schemaData.steps.map((step: string, i: number) => ({
      '@type': 'HowToStep',
      position: i + 1,
      text: step,
    }));
  }
} else if (schemaType === 'FAQ' && schemaData) {
  // FAQ-specific fields. Canonical field is `items`; older frontmatter used
  // `faqItems` (MDX editor) or `questions` (this template).
  const faqEntries = schemaData.items ?? schemaData.faqItems ?? schemaData.questions;
  if (Array.isArray(faqEntries) && faqEntries.length > 0) {
    jsonLd.mainEntity = faqEntries.map((q: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: q.answer,
      },
    }));
  }
} else if (schemaType === 'Product' && schemaData) {
  // Product-specific fields
  if (schemaData.brand) jsonLd.brand = { '@type': 'Brand', name: schemaData.brand };
  if (schemaData.price) {
    jsonLd.offers = {
      '@type': 'Offer',
      price: schemaData.price,
      priceCurrency: schemaData.currency || 'USD',
      availability: schemaData.availability || 'https://schema.org/InStock',
    };
  }
} else if (schemaType === 'Event' && schemaData) {
  // Event-specific fields
  if (schemaData.startDate) jsonLd.startDate = schemaData.startDate;
  if (schemaData.endDate) jsonLd.endDate = schemaData.endDate;
  if (schemaData.location) {
    jsonLd.location = {
      '@type': 'Place',
      name: schemaData.location,
      address: schemaData.address,
    };
  }
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <link rel="preconnect" href="https://pagesmith-cdn.com" crossorigin />
    <link rel="preload" href="/_pagesmith/fonts/manrope-400.woff2" as="font" type="font/woff2" crossorigin />
    <SEOHead
      title={
        frontmatter.title?.includes(SITE.name) || frontmatter.title?.includes('M&G Security')
          ? frontmatter.title
          : `${frontmatter.title} – ${SITE.name}`
      }
      description={frontmatter.description}
      image={socialImage}
      type="article"
      publishedTime={frontmatter.pubDate?.toISOString?.()}
      modifiedTime={frontmatter.updatedDate?.toISOString?.()}
      canonicalUrl={frontmatter.canonicalUrl}
      jsonLd={finalJsonLd}
    />
  </head>
  <body class="min-h-screen bg-background text-foreground" data-ps="src/layouts/BlogLayout.astro:rqzn4e">
    <Navigation />

    <!-- Hero Section (Matches Security Services Layout) -->
    <section
      id="hero"
      class="relative bg-dark-background pt-[140px] pb-[60px] md:pt-[160px] md:pb-[80px] flex flex-col items-center justify-center text-center overflow-hidden"
      data-ps="src/layouts/BlogLayout.astro:hero"
    >
      {heroBgImage && (
        <div class="absolute inset-0 z-0" data-ps="src/layouts/BlogLayout.astro:hero-bg-image-wrapper">
          <img
            src={heroBgImage}
            alt={frontmatter.imageAlt || frontmatter.title}
            class="w-full h-full object-cover opacity-45"
            loading="eager"
            fetchpriority="high"
            data-ps="src/layouts/BlogLayout.astro:hero-bg-image"
          />
          <div class="absolute inset-0 bg-dark-background/65" data-ps="src/layouts/BlogLayout.astro:o33ul6"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-dark-background/40 via-transparent to-dark-background" data-ps="src/layouts/BlogLayout.astro:o33ul5"></div>
        </div>
      )}
      <div class="absolute inset-0 pointer-events-none z-0" style="background: radial-gradient(at 100% 0%, oklch(0.75 0.16 85 / 0.12), rgba(0, 0, 0, 0) 55%);" data-ps="src/layouts/BlogLayout.astro:ynx9gk"></div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 flex flex-col items-center justify-center text-center" data-ps="src/layouts/BlogLayout.astro:ynx9gl">
        <div class="flex items-center gap-2 mb-5 text-primary text-[12px] uppercase font-bold tracking-widest" data-ps="src/layouts/BlogLayout.astro:eyebrow">
          <span class="w-1.5 h-4 bg-primary" data-ps="src/layouts/BlogLayout.astro:9v224h"></span>
          {frontmatter.category || 'Security Insights'}
        </div>

        <h1 class="text-dark-foreground text-[32px] sm:text-[44px] md:text-[54px] lg:text-[58px] leading-[1.1] font-bold uppercase tracking-tight max-w-4xl font-heading" data-ps="src/layouts/BlogLayout.astro:title">
          {frontmatter.title}
        </h1>

        {frontmatter.description && (
          <p class="mt-6 text-primary text-[16px] md:text-[18px] font-semibold leading-[26px] max-w-3xl" data-ps="src/layouts/BlogLayout.astro:subtitle">
            {frontmatter.description}
          </p>
        )}
      </div>
    </section>

    <!-- Breadcrumb Bar -->
    <div class="border-y border-border bg-surface/60 py-3.5" data-ps="src/layouts/BlogLayout.astro:breadcrumbs-bar">
      <div class="max-w-7xl mx-auto px-6" data-ps="src/layouts/BlogLayout.astro:ynx9gm">
        <nav class="text-[11px] uppercase tracking-wider font-bold text-muted-foreground flex items-center gap-2 flex-wrap" data-ps="src/layouts/BlogLayout.astro:breadcrumbs-nav">
          <a href="/" class="hover:text-primary transition-colors" data-ps="src/layouts/BlogLayout.astro:th3ncz">HOME</a>
          <span class="text-border" data-ps="src/layouts/BlogLayout.astro:9v224i">/</span>
          <a href="/articles/" class="hover:text-primary transition-colors" data-ps="src/layouts/BlogLayout.astro:th3nd0">ARTICLES</a>
          <span class="text-border" data-ps="src/layouts/BlogLayout.astro:9v224j">/</span>
          <span class="text-foreground truncate max-w-md" data-ps="src/layouts/BlogLayout.astro:9v224k">{frontmatter.title}</span>
        </nav>
      </div>
    </div>

    <!-- Main Content & Sidebar Layout -->
    <main class="bg-background py-16 md:py-24" data-ps="src/layouts/BlogLayout.astro:main-section">
      <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16 items-start" data-ps="src/layouts/BlogLayout.astro:grid-container">
        
        <!-- Left Article Column -->
        <article
          class="lg:col-span-2 min-w-0"
          data-mdx-file={mdxFilePath}
          data-mdx-type="blog"
          data-ps="src/layouts/BlogLayout.astro:article"
        >
          <!-- Article Metadata Bar -->
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-border" data-ps="src/layouts/BlogLayout.astro:meta-bar">
            <div class="flex items-center gap-3" data-ps="src/layouts/BlogLayout.astro:ynx9gn">
              <div class="w-10 h-10 bg-primary/10 border border-primary/20 flex items-center justify-center text-primary shrink-0" data-ps="src/layouts/BlogLayout.astro:ynx9go">
                <i class="ri-shield-check-line text-xl" aria-hidden="true"></i>
              </div>
              <div data-ps="src/layouts/BlogLayout.astro:ynx9gp">
                <div class="text-[10.5px] uppercase font-bold tracking-widest text-primary" data-ps="src/layouts/BlogLayout.astro:ynx9gq">M&G Security</div>
                <div class="text-[13px] text-muted-foreground font-medium" data-ps="src/layouts/BlogLayout.astro:o33ule">
                  {frontmatter.author ? `By ${frontmatter.author}` : 'Professional Security Staff'}
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-3 text-[12px] text-muted-foreground" data-ps="src/layouts/BlogLayout.astro:o33uld">
              {frontmatter.pubDate && (
                <time datetime={frontmatter.pubDate.toISOString()} class="flex items-center gap-1.5 font-medium">
                  <i class="ri-calendar-line text-primary" aria-hidden="true"></i>
                  {frontmatter.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              )}
              {frontmatter.readingTime && (
                <span class="flex items-center gap-1.5" data-ps="src/layouts/BlogLayout.astro:9v2256">
                  <span class="text-border" data-ps="src/layouts/BlogLayout.astro:9v2257">•</span>
                  <span data-ps="src/layouts/BlogLayout.astro:9v2258">{frontmatter.readingTime}</span>
                </span>
              )}
            </div>
          </div>

          <!-- Featured Image -->
          {frontmatter.image && (
            <figure class="mb-10 overflow-hidden border border-gray-100 shadow-sm" data-ps="src/layouts/BlogLayout.astro:featured-figure">
              <img
                src={frontmatter.image}
                alt={frontmatter.imageAlt || frontmatter.title}
                class="w-full h-auto max-h-[500px] object-cover"
                data-ps="src/layouts/BlogLayout.astro:featured-image"
              />
            </figure>
          )}

          <!-- Prose Article Content -->
          <div
            class="prose prose-lg max-w-none text-muted-foreground prose-headings:font-heading prose-headings:font-bold prose-headings:uppercase prose-headings:tracking-tight prose-headings:text-foreground prose-h2:text-[24px] prose-h2:md:text-[28px] prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-border/60 prose-h2:pb-3 prose-h3:text-[18px] prose-h3:md:text-[20px] prose-h3:mt-8 prose-h3:mb-3 prose-p:text-[16px] prose-p:leading-[28px] prose-strong:text-foreground prose-strong:font-bold prose-a:text-primary prose-a:font-semibold prose-a:underline hover:prose-a:text-primary-hover prose-li:text-[15px] prose-li:leading-[26px]"
            data-ps="src/layouts/BlogLayout.astro:content-body"
          >
            <slot />
          </div>

          <!-- Custom Styled In-Article CTA Box -->
          {(frontmatter.ctaTitle || frontmatter.ctaText || frontmatter.ctaButtonText) && (
            <div class="mt-14 bg-surface border-l-4 border-primary border-t border-r border-b border-gray-100 p-8 md:p-10 shadow-sm rounded-none" data-ps="src/layouts/BlogLayout.astro:in-article-cta">
              <div class="flex items-center gap-2 mb-3 text-primary text-[11px] uppercase font-bold tracking-widest" data-ps="src/layouts/BlogLayout.astro:o33ulc">
                <i class="ri-shield-star-line text-lg" aria-hidden="true"></i>
                <span data-ps="src/layouts/BlogLayout.astro:9v2259">Security Consultation</span>
              </div>
              <h3 class="text-[22px] md:text-[26px] font-bold uppercase tracking-tight text-foreground mb-3 font-heading" data-ps="src/layouts/BlogLayout.astro:in-article-cta-title">
                {frontmatter.ctaTitle || 'Protect Your Property With 24/7 M&G Security'}
              </h3>
              <p class="text-[15px] leading-relaxed text-muted-foreground mb-6" data-ps="src/layouts/BlogLayout.astro:in-article-cta-text">
                {frontmatter.ctaText || 'Contact M&G Security today for a tailored security assessment and quote for your property, business, or event.'}
              </p>
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3" data-ps="src/layouts/BlogLayout.astro:o33ulb">
                <a
                  href={SITE.phoneHref}
                  class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-6 py-3.5 rounded-none hover:bg-primary-hover transition-colors flex items-center justify-center gap-2 text-center"
                 data-ps="src/layouts/BlogLayout.astro:th3nd1">
                  <i class="ri-phone-line" aria-hidden="true"></i> Call {SITE.phone}
                </a>
                <a
                  href={frontmatter.ctaButtonLink || '/contact-us/'}
                  class="border border-border text-foreground font-bold uppercase tracking-wider text-[12px] px-6 py-3.5 rounded-none hover:bg-background transition-colors flex items-center justify-center gap-2 text-center"
                 data-ps="src/layouts/BlogLayout.astro:th3nd2">
                  <i class="ri-mail-line" aria-hidden="true"></i> {frontmatter.ctaButtonText || 'Request a Quote'}
                </a>
              </div>
            </div>
          )}

          <!-- FAQs Section -->
          {frontmatter.faqs && frontmatter.faqs.length > 0 && (
            <div class="mt-16 pt-12 border-t border-border" data-ps="src/layouts/BlogLayout.astro:faq-section">
              <div class="w-6 h-0.5 bg-primary mb-3" data-ps="src/layouts/BlogLayout.astro:o33ula"></div>
              <h2 class="text-[26px] md:text-[30px] font-bold uppercase tracking-tight mb-8 font-heading text-foreground" data-ps="src/layouts/BlogLayout.astro:faq-title">
                Frequently Asked Questions
              </h2>
              <div class="flex flex-col gap-6" data-ps="src/layouts/BlogLayout.astro:faq-list">
                {frontmatter.faqs.map((faq: any, i: number) => (
                  <div class="bg-surface border border-gray-100 p-6 md:p-8 shadow-sm" data-ps={`src/layouts/BlogLayout.astro:faq-${i}`}>
                    <h3 class="text-[18px] font-bold text-foreground mb-3 font-heading uppercase tracking-wide flex items-start gap-2" data-ps={`src/layouts/BlogLayout.astro:faq-q-${i}`}>
                      <span class="text-primary font-bold" data-ps={`src/layouts/BlogLayout.astro:9v225a-${i}`}>Q.</span>
                      <span data-ps={`src/layouts/BlogLayout.astro:9v225b-${i}`}>{faq.question}</span>
                    </h3>
                    <p class="text-muted-foreground leading-relaxed text-[15px] pl-6" data-ps={`src/layouts/BlogLayout.astro:faq-a-${i}`}>
                      {faq.answer}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Tags -->
          {frontmatter.tags && frontmatter.tags.length > 0 && (
            <footer class="mt-12 pt-8 border-t border-border flex flex-wrap items-center gap-2" data-ps="src/layouts/BlogLayout.astro:tags-wrap">
              <span class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground mr-2" data-ps="src/layouts/BlogLayout.astro:9v225c">Topics:</span>
              {frontmatter.tags.map((tag: string, __psIdx: number) => (
                <span class="px-3 py-1 text-xs font-semibold bg-surface border border-gray-100 text-foreground" data-ps={`src/layouts/BlogLayout.astro:tag-${__psIdx}`}>
                  #{tag}
                </span>
              ))}
            </footer>
          )}
        </article>

        <!-- Right Sidebar (Matching Security Services Layout) -->
        <aside class="lg:sticky lg:top-28 flex flex-col gap-8" data-ps="src/layouts/BlogLayout.astro:sidebar">
          
          <!-- Table of Contents -->
          <TableOfContents headings={headings} />

          <!-- Card 1: Request This Service -->
          <div class="bg-surface border border-gray-100 p-8 rounded-none shadow-sm" data-ps="src/layouts/BlogLayout.astro:sidebar-request-card">
            <h4 class="text-foreground text-[16px] font-bold uppercase font-heading tracking-wide mb-3" data-ps="src/layouts/BlogLayout.astro:sidebar-request-title">
              REQUEST THIS SERVICE
            </h4>
            <p class="text-[14px] leading-relaxed text-muted-foreground mb-6" data-ps="src/layouts/BlogLayout.astro:sidebar-request-text">
              Contact M&G Security today for a tailored security assessment and quote for your property, event, or facility security needs.
            </p>
            <div class="flex flex-col gap-3" data-ps="src/layouts/BlogLayout.astro:o33ul9">
              <a
                href={SITE.phoneHref}
                class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-6 py-3.5 rounded-none hover:bg-primary-hover transition-colors flex items-center justify-center gap-2 text-center"
                data-ps="src/layouts/BlogLayout.astro:sidebar-phone-btn"
              >
                <i class="ri-phone-line" aria-hidden="true"></i> Call {SITE.phone}
              </a>
              <a
                href="/contact-us/"
                class="border border-border text-foreground font-bold uppercase tracking-wider text-[12px] px-6 py-3.5 rounded-none hover:bg-background transition-colors flex items-center justify-center gap-2 text-center"
                data-ps="src/layouts/BlogLayout.astro:sidebar-quote-btn"
              >
                <i class="ri-mail-line" aria-hidden="true"></i> Request a Quote
              </a>
            </div>
          </div>

          <!-- Card 2: Why Choose M&G -->
          <div class="bg-surface border border-gray-100 p-8 rounded-none shadow-sm" data-ps="src/layouts/BlogLayout.astro:sidebar-why-card">
            <h4 class="text-foreground text-[16px] font-bold uppercase font-heading tracking-wide mb-6" data-ps="src/layouts/BlogLayout.astro:sidebar-why-title">
              WHY CHOOSE M&G
            </h4>
            <ul class="flex flex-col gap-4" data-ps="src/layouts/BlogLayout.astro:sidebar-why-list">
              <li class="flex items-start gap-3 text-[14px] leading-[22px] text-muted-foreground" data-ps="src/layouts/BlogLayout.astro:hmgf42">
                <i class="ri-shield-check-line text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span data-ps="src/layouts/BlogLayout.astro:9v225d">KRE Security LLC. is bonded and insured to provide the services offered to our clients.</span>
              </li>
              <li class="flex items-start gap-3 text-[14px] leading-[22px] text-muted-foreground" data-ps="src/layouts/BlogLayout.astro:hmgf43">
                <i class="ri-shield-check-line text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span data-ps="src/layouts/BlogLayout.astro:9v225e">KRE Security LLC. conducts every investigation ethically, morally, legally and with the highest degree of integrity.</span>
              </li>
              <li class="flex items-start gap-3 text-[14px] leading-[22px] text-muted-foreground" data-ps="src/layouts/BlogLayout.astro:hmgf44">
                <i class="ri-shield-check-line text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span data-ps="src/layouts/BlogLayout.astro:9v225f">KRE Security LLC. was founded in August of 1990 and recently acquired M&amp;G Security expanding our capabilities and footprint in PA.</span>
              </li>
              <li class="flex items-start gap-3 text-[14px] leading-[22px] text-muted-foreground" data-ps="src/layouts/BlogLayout.astro:hmgf45">
                <i class="ri-shield-check-line text-primary text-base mt-0.5 shrink-0" aria-hidden="true"></i>
                <span data-ps="src/layouts/BlogLayout.astro:9v2261">24/7 availability for emergencies</span>
              </li>
            </ul>
          </div>

        </aside>
      </div>
    </main>

    <!-- Bottom Full-Width CTA Banner (Matching Security Services Layout) -->
    <section id="bottom-cta" class="relative bg-dark-background py-20 overflow-hidden border-t border-dark-border/40" data-ps="src/layouts/BlogLayout.astro:bottom-cta">
      <div class="absolute inset-0 bg-[radial-gradient(at_75%_50%,oklch(0.75_0.16_85/0.1),rgba(0,0,0,0)_60%)] pointer-events-none" data-ps="src/layouts/BlogLayout.astro:o33ul8"></div>
      <div class="relative max-w-7xl mx-auto px-6 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8" data-ps="src/layouts/BlogLayout.astro:o33ul7">
        <div data-ps="src/layouts/BlogLayout.astro:o33ul6">
          <h2 class="text-dark-foreground text-[30px] md:text-[36px] leading-[42px] font-bold uppercase tracking-tight font-heading" data-ps="src/layouts/BlogLayout.astro:gvhinv">
            {frontmatter.ctaTitle ? (frontmatter.ctaTitle.toUpperCase().startsWith('NEED') ? frontmatter.ctaTitle : `NEED ${frontmatter.ctaTitle.toUpperCase()}?`) : 'NEED PROFESSIONAL SECURITY SERVICES?'}
          </h2>
          <p class="mt-4 text-dark-muted-foreground text-[16px] leading-[24px] max-w-3xl" data-ps="src/layouts/BlogLayout.astro:md5qow">
            {frontmatter.ctaText || 'Contact us today for a tailored security assessment and quote. Our team is ready to protect your people, property, and peace of mind.'}
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 shrink-0" data-ps="src/layouts/BlogLayout.astro:o33ul5">
          <a
            href={SITE.phoneHref}
            class="bg-primary text-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-primary-hover transition-colors flex items-center justify-center gap-2 whitespace-nowrap"
           data-ps="src/layouts/BlogLayout.astro:th3nd3">
            <i class="ri-phone-line" aria-hidden="true"></i> Call {SITE.phone}
          </a>
          <a
            href={frontmatter.ctaButtonLink || '/contact-us/'}
            class="border border-dark-foreground/30 text-dark-foreground font-bold uppercase tracking-wider text-[12px] px-8 py-4 rounded-none hover:bg-white/5 transition-colors flex items-center justify-center gap-2 whitespace-nowrap"
           data-ps="src/layouts/BlogLayout.astro:th3nd4">
